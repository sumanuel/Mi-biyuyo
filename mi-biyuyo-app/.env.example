# URL base de la API de Mi Biyuyo (incluye /api, sin barra final).
# Copia este archivo como .env y ajusta el valor. Expo solo lee las variables que
# empiezan con EXPO_PUBLIC_ y las incluye al iniciar Metro o al compilar la app.

# Desarrollo en un celular físico (IP de tu PC en la red local)
EXPO_PUBLIC_API_URL=http://192.168.1.2:3001/api

# Producción (siempre con HTTPS)
# EXPO_PUBLIC_API_URL=https://mi-biyuyo.system-meek.com/api
