{
  "name": "mi-biyuyo-api",
  "version": "1.0.0",
  "description": "API para Mi Biyuyo - Control de finanzas personales",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node database/migrate.js",
    "migrate:prod": "node -r dotenv/config database/migrate.js dotenv_config_path=.env.production",
    "seed": "node database/seed.js",
    "seed:demo": "node database/seed_demo.js",
    "setup": "node database/migrate.js && node database/seed.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.12",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
